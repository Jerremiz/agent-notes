{
  "name": "agent-notes",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "agent-notes",
      "devDependencies": {
        "notes-theme": "file:../notes-theme"
      }
    },
    "../notes-theme": {
      "version": "0.1.0",
      "dev": true,
      "dependencies": {
        "markdown-it": "15.0.2",
        "markdown-it-cjk-friendly": "3.0.0"
      },
      "bin": {
        "notes-build": "bin/build.mjs",
        "notes-dev": "bin/dev.mjs"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/notes-theme": {
      "resolved": "../notes-theme",
      "link": true
    }
  }
}
